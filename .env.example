# Copy to .env and fill in. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-64-random-chars
ADMIN_EMAIL=amanasmuei@gmail.com
ADMIN_PASSWORD=change-me-admin-password
# Public domain the site is served from (no scheme)
DOMAIN=devdesk.example.com
# Origin Caddy serves (used for CORS)
WEB_ORIGIN=https://devdesk.example.com
# Public URL of the API as seen from browsers (same domain via Caddy)
PUBLIC_API_URL=https://devdesk.example.com
# Set false only for local http testing
COOKIE_SECURE=true
