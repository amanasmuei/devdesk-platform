# HTTP port the API listens on
PORT=8080

# Postgres connection string
DATABASE_URL=postgres://devdesk:devdesk@localhost:5432/devdesk?sslmode=disable

# Secret used to sign session JWTs; replace with a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap admin account, created on startup if missing
ADMIN_EMAIL=amanasmuei@gmail.com
ADMIN_PASSWORD=change-me

# Web app origin allowed by CORS (credentials included)
WEB_ORIGIN=http://localhost:3000

# Set true when serving over HTTPS so cookies carry the Secure flag
COOKIE_SECURE=false
